  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "SPIKE", "class_name": "SpikeObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpikeObject"] }]
}
