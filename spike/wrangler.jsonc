{
  // Throwaway Worker for the milestone 0 free-plan spikes. Delete it after the results are recorded:
  //   pnpm wrangler delete --config spike/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "getsecondbrain-spike",
  "main": "spike.ts",
