{
  "name": "getsecondbrain",
  "description": "Linked markdown notes that every AI app can read and write, through one remote MCP server.",
  "license": "AGPL-3.0-only",
  "homepage": "https://www.getsecondbrain.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhushan/getsecondbrain.io.git"
  },
  "bugs": {
    "url": "https://github.com/bhushan/getsecondbrain.io/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "types": "wrangler types && tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p src/web",
    "check": "pnpm types && pnpm test && pnpm build && wrangler deploy --dry-run --env production",
    "deploy:production": "pnpm build && wrangler d1 migrations apply getsecondbrain-production --remote --env production && wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.34.0",
    "codemirror": "^6.0.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "4.0.6",
    "zod": "^4.6.7"
  }
}
